{
  "name": "castiq-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json",
    "dev": "node scripts/dev.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --experimental-strip-types --test tests/v1Workflow.test.ts tests/clubTime.test.ts",
    "dev:demo": "VITE_DATA_MODE=demo vite --host 127.0.0.1 --port 4173 --strictPort",
    "local:setup": "node scripts/local-setup.mjs",
    "local:stop": "docker compose -f compose.local.yaml stop",
    "server": "node --env-file-if-exists=.env.local server/index.ts",
    "db:migrate": "node --env-file-if-exists=.env.local database/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local database/seed.ts",
    "test:server": "node --env-file-if-exists=.env.local --test tests/server*.test.ts tests/pilotWeekend.test.ts",
    "test:browser": "playwright test",
    "verify:assets": "node scripts/verify-assets.mjs",
    "local:backup": "node --env-file=.env.local scripts/local-backup.mjs",
    "worker": "node --env-file-if-exists=.env.local server/worker.ts",
    "config:check": "node --env-file-if-exists=.env.local scripts/check-config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "0.468.0",
    "motion": "12.43.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.16.0"
}
