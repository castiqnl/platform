# De enige vier GitHub environment variables (staging en production). Alle vier zijn publieke buildconfig.
# Vite neemt deze namen expliciet over; er is geen Next.js-migratie nodig.
CASTIQ_APP_ORIGIN=
CASTIQ_DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# Afzonderlijke runtimeconfig op de doelhost, buiten GitHub en buiten buildaccount.
# Dezelfde vier publieke waarden horen ook bij deze runtimeversie.
APP_ENV=staging
AUTH_MODE=supabase
HOST=127.0.0.1
PORT=
DATABASE_URL=
UPLOAD_DIR=
PUBLICATION_MODE=sandbox
RELEASE_SHA=
MAIL_ENCRYPTION_KEY=
PRIVACY_LEDGER_HMAC_KEY=
SUPABASE_ACCOUNT_OPERATIONS_KEY=
PRIVACY_LEDGER_DIR=
PRIVACY_RETENTION_EXECUTE=false
# Lokale oude APP_ORIGIN/SUPABASE_*/VITE_* namen blijven compatibel;
# conflicterende oude en nieuwe waarden worden geweigerd.
