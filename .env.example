# Voorbeeld zonder waarden. Gebruik lokaal npm run local:setup.
# Browser leest geen van de secrets hieronder. Alleen VITE_* is publieke buildconfig.
APP_ENV=staging
AUTH_MODE=supabase
HOST=127.0.0.1
PORT=4174
APP_ORIGIN=
DATABASE_URL=
UPLOAD_DIR=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Publieke Vite-buildconfig voor echte OTP/Google-aanmelding (zelfde project als server):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_AUTH_GOOGLE_ENABLED=false
PUBLICATION_MODE=sandbox
RELEASE_SHA=
# Optioneel expliciete browserdemo (buildtijd): VITE_DATA_MODE=demo
